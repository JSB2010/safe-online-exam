{
  "name": "safe-online-exam",
  "version": "1.0.5",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JSB2010/safe-online-exam.git"
  },
  "homepage": "https://github.com/JSB2010/safe-online-exam#readme",
  "bugs": {
    "url": "https://github.com/JSB2010/safe-online-exam/issues"
  },
  "type": "module",
  "packageManager": "npm@11.19.0+sha512.48377f8478372aa1c4e47b763475b135836da82436a5700f2e5e8eb5084fc840f93c7b117eb3ad3b5f7d3194c81b6710a10d59448f6ddbcb21ac3fb672bdc003",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "dev:client": "vite --host 127.0.0.1 --port 5173",
    "db:migrate": "tsx src/server/data/migrate.ts",
    "db:migrate:built": "node dist/server/server/data/migrate.js",
    "db:cleanup": "tsx src/server/data/cleanup.ts --drain",
    "db:cleanup:built": "node dist/server/server/data/cleanup.js --drain",
    "db:encrypt-oauth-tokens": "tsx src/server/data/encrypt-oauth-tokens.ts",
    "db:encrypt-oauth-tokens:built": "node dist/server/server/data/encrypt-oauth-tokens.js",
    "db:reset:gcloud:dev": "bash scripts/reset-gcloud-dev-database.sh",
    "build": "npm run build:client && npm run build:server",
    "verify:dependency-policy": "node scripts/verify-install-scripts.mjs",
    "verify:dependency-policy:offline": "node scripts/verify-install-scripts.mjs --skip-release-age",
    "install:trusted": "npm run verify:dependency-policy:offline && npm rebuild esbuild --ignore-scripts=false && node scripts/verify-esbuild.mjs",
    "verify:supply-chain": "npm run verify:dependency-policy && npm audit signatures && npm audit --omit=dev --audit-level=high",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-server-assets.mjs",
    "build:client": "vite build",
    "start": "node dist/server/server/main.js",
    "test": "vitest run test/server",
    "test:coverage": "vitest run test/server --coverage",
    "test:e2e": "playwright test",
    "test:postgres": "vitest run test/postgres",
    "verify:postgres": "bash scripts/postgres-integration.sh",
    "release:check": "node scripts/verify-release.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "migrate:exam-tools": "tsx scripts/migrate-exam-tools.ts",
    "generate:lti-key": "node scripts/generate-lti-private-key.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "verify": "npm run release:check && npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build",
    "verify:e2e": "npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "clsx": "2.1.1",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "jose": "6.2.8",
    "lucide-react": "1.28.0",
    "pg": "8.22.0",
    "plist": "5.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reflect-metadata": "0.2.2"
  },
  "overrides": {
    "multer": "2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.4",
    "@types/plist": "3.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents": false
  }
}
