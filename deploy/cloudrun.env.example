# Copy this file to cloudrun.env, keep that file private, and replace every
# required value. Release bundles replace APP_IMAGE with the published digest.
# Keep cloudrun.env in a durable installation directory. Relative bootstrap,
# client-identity, and state paths below are resolved from that directory.
APP_VERSION=1.0.6
APP_IMAGE=ghcr.io/jsb2010/safe-online-exam@sha256:REPLACE_WITH_RELEASE_DIGEST

PROJECT_ID=replace-with-gcp-project
REGION=us-central1
# One lowercase stem keeps every newly provisioned resource on-brand. Add a
# short school suffix when useful, for example safe-online-exam-school. Leave
# these overrides empty to derive them from RESOURCE_NAME automatically.
RESOURCE_NAME=safe-online-exam
SERVICE=
SQL_INSTANCE=
DATABASE_NAME=
DATABASE_USER=
DATABASE_POOL_MAX=5
SECRET_PREFIX=
RUNTIME_SERVICE_ACCOUNT_NAME=
SCHEDULER_SERVICE_ACCOUNT_NAME=

# production-zonal is the recommended cost-conscious baseline: Cloud SQL
# Enterprise, 1 dedicated vCPU, 3.75 GiB memory, one zone, daily backups,
# seven-day PITR, deletion protection, encrypted connector-only access, and
# storage auto-growth. It trades automatic cross-zone failover and the HA SLA
# for a much lower bill. Run `./prepare.sh --list-cloud-sql-profiles` for every
# supported profile, current reference prices, terms, and tradeoffs.
# existing-reviewed requires an institution-supplied instance and never creates
# Cloud SQL. prepare.sh creates a missing instance only with --create-sql.
CLOUD_SQL_PROFILE=production-zonal
CLOUD_SQL_STORAGE_SIZE_GB=20
CLOUD_SQL_STORAGE_AUTO_INCREASE_LIMIT_GB=100
CLOUD_SQL_BACKUP_START_TIME=06:00
CLOUD_SQL_RETAINED_BACKUPS=14
CLOUD_SQL_PITR_DAYS=7
CLOUD_SQL_FINAL_BACKUP_RETENTION_DAYS=30
CLOUD_SQL_MAINTENANCE_DAY=SUN
CLOUD_SQL_MAINTENANCE_HOUR=9

# prepare.sh reserves a stable run.app URL and writes it to the protected
# bootstrap directory. Set TOOL_URL only when using a custom HTTPS origin. If
# using Cloud Run domain mapping, run ./map-domain.sh after prepare.sh and wait
# for its Ready condition before continuing Canvas setup.
TOOL_URL=
# Set true only after the custom TOOL_URL is independently ready. Finalization
# and later upgrades verify the custom origin before re-disabling the generated
# run.app URL after candidate verification and traffic cutover.
DISABLE_DEFAULT_URL_AFTER_FINALIZE=false
CANVAS_DOMAIN=
CANVAS_API_CLIENT_ID=

APP_ENV=prod
LTI_DEPLOYMENT_ID_CHECKING_ENABLED=true
# Fresh installs use enforce. Existing installs upgrading from a release that
# stored plaintext tokens should follow the staged compat/enforce procedure.
OAUTH_TOKEN_ENCRYPTION_MODE=enforce
OAUTH_TOKEN_ENCRYPTION_ACTIVE_KEY_ID=primary
SEB_CONFIG_ENCRYPTION_ENABLED=true

# Canvas cloud defaults. Override all three for a self-hosted Canvas issuer.
LTI_ISSUER=https://canvas.instructure.com
LTI_KEY_SET_URL=https://sso.canvaslms.com/api/lti/security/jwks
LTI_AUTH_URL=https://sso.canvaslms.com/api/lti/authorize_redirect

MEMORY=2Gi
CPU=2
# Zero avoids an approximately $21/month warm-instance baseline. Set 1 when
# avoiding an occasional first-request cold start is worth that fixed cost.
MIN_INSTANCES=0
MAX_INSTANCES=10
REQUEST_TIMEOUT=600s

CLEANUP_SCHEDULE="17 3 * * *"
CLEANUP_TIME_ZONE=Etc/UTC
PUBLIC_ACCESS=true

# Google API activation and instance provisioning can be eventually consistent.
# prepare.sh polls safely instead of retrying an ambiguous create operation.
CLOUD_SQL_API_READY_TIMEOUT_SECONDS=300
CLOUD_SQL_INSTANCE_READY_TIMEOUT_SECONDS=900
CLOUD_SQL_RETRY_INTERVAL_SECONDS=5

# Local protected state. Do not place these directories under source control or
# under /tmp, /private/tmp, or TMPDIR; bootstrap-secrets.sh rejects temporary
# locations so the client P12 and deployment record cannot be auto-purged.
BOOTSTRAP_DIRECTORY=.local/safe-online-exam-cloudrun-bootstrap
CLIENT_IDENTITY_DIRECTORY=.local/safe-online-exam-client-identity
STATE_DIRECTORY=.state

# Set true only when DATABASE_USER already exists and the matching password has
# been placed in BOOTSTRAP_DIRECTORY/database_password.
ALLOW_EXISTING_DATABASE_USER=false
