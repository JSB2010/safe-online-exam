# Copy to .env, replace every placeholder, then run: docker compose up -d
APP_IMAGE=ghcr.io/jsb2010/safe-online-exam:1.0.6
APP_ENV_FILE=.env
BIND_ADDRESS=127.0.0.1
APP_PORT=8080
SECRETS_DIRECTORY=./secrets

NODE_ENV=production
APP_ENV=prod
HOST=0.0.0.0
PORT=8080
TOOL_URL=https://seb-tool.example.edu
CANVAS_DOMAIN=https://school.instructure.com
CANVAS_REDIRECT_URI=https://seb-tool.example.edu/api/oauth2callback

LTI_CLIENT_ID=replace-with-canvas-lti-client-id
LTI_PRIVATE_KEY=replace-with-generated-rsa-private-jwk-json
# Alternative: LTI_PRIVATE_KEY_FILE=/run/secrets/lti_private_key
LTI_DEPLOYMENT_ID=replace-with-canvas-lti-deployment-id
CANVAS_API_CLIENT_ID=replace-with-canvas-developer-key-id
CANVAS_API_CLIENT_SECRET=replace-with-canvas-developer-key-secret
# Alternative: CANVAS_API_CLIENT_SECRET_FILE=/run/secrets/canvas_api_client_secret

DATABASE_NAME=canvas_seb
DATABASE_USER=canvas_seb
DATABASE_PASSWORD=replace-with-a-long-random-database-password
# Alternative for the app only: DATABASE_PASSWORD_FILE=/run/secrets/database_password
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000

SESSION_SECRET=replace-with-at-least-32-random-characters
# Alternative: SESSION_SECRET_FILE=/run/secrets/session_secret
STATE_ENCRYPTION_KEY=replace-with-a-different-32-character-random-value
# Alternative: STATE_ENCRYPTION_KEY_FILE=/run/secrets/state_encryption_key
OAUTH_TOKEN_ENCRYPTION_MODE=enforce
OAUTH_TOKEN_ENCRYPTION_ACTIVE_KEY_ID=primary
OAUTH_TOKEN_ENCRYPTION_KEYRING={"primary":"replace-with-a-32-byte-base64url-key"}
# Alternative: OAUTH_TOKEN_ENCRYPTION_KEYRING_FILE=/run/secrets/oauth_token_encryption_keyring
SEB_QUIT_PASSWORD=
# Alternative: SEB_QUIT_PASSWORD_FILE=/run/secrets/seb_quit_password
SEB_REQUIRED_DOMAINS=
SEB_CONFIG_ENCRYPTION_ENABLED=true
# Certificate encryption is enabled by default. Set false only when managed-client
# certificate deployment is not possible. Place the public certificate at ./secrets/seb-config-encryption.crt.pem when enabled.

APP_DEBUG_ENABLED=false
APP_DETECTOR_DIAGNOSTICS_ENABLED=false
