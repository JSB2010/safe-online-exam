NODE_ENV=development
APP_ENV=dev
HOST=127.0.0.1
PORT=8080
USE_IN_MEMORY_STORE=true

TOOL_URL=http://localhost:8080
LTI_CLIENT_ID=test-client
LTI_PRIVATE_KEY=
LTI_DEPLOYMENT_ID=

CANVAS_DOMAIN=https://school.instructure.com
CANVAS_API_CLIENT_ID=test-client-id
CANVAS_API_CLIENT_SECRET=test-client-secret
CANVAS_REDIRECT_URI=http://localhost:8080/api/oauth2callback

GCP_PROJECT_ID=
FIRESTORE_DATABASE_ID=canvas-seb-local
FIRESTORE_ASSESSMENTS_COLLECTION=assessments
FIRESTORE_COURSES_COLLECTION=courses
FIRESTORE_OAUTH_TOKENS_COLLECTION=canvasOAuthTokens
FIRESTORE_SESSIONS_COLLECTION=sessions
FIRESTORE_TRANSIENT_STATES_COLLECTION=transientStates
FIRESTORE_OPERATION_LOCKS_COLLECTION=operationLocks

SESSION_SECRET=local-session-secret
STATE_ENCRYPTION_KEY=local-state-encryption-key
APP_DEBUG_ENABLED=true
SEB_QUIT_PASSWORD=
SEB_REQUIRED_DOMAINS=accounts.google.com,*.googleusercontent.com,*.gstatic.com,ssl.gstatic.com,*.google.com,*.canvas-user-content.com,*.instructuremedia.com,*.canvaslms.com,*.inscloudgate.net
SEB_CONFIG_ENCRYPTION_ENABLED=true
SEB_CONFIG_ENCRYPTION_CERT_PATH=.local/seb-certs/seb-config-encryption-local.crt.pem
