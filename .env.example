NODE_ENV=development
APP_ENV=dev
HOST=127.0.0.1
PORT=8080
USE_IN_MEMORY_STORE=true

TOOL_URL=http://localhost:8080
LTI_CLIENT_ID=test-client
LTI_PRIVATE_KEY=
# Alternative: LTI_PRIVATE_KEY_FILE=/run/secrets/lti_private_key
# Default true. Set false only to accept every signed launch from this Canvas issuer and LTI client ID.
LTI_DEPLOYMENT_ID_CHECKING_ENABLED=true
# Required when deployment-ID checking is enabled; supports a comma/newline allowlist.
LTI_DEPLOYMENT_ID=
# Canvas cloud defaults are built in. Self-hosted overrides must remain credential-free HTTPS URLs.
# LTI_ISSUER=https://canvas.instructure.com
# LTI_KEY_SET_URL=https://sso.canvaslms.com/api/lti/security/jwks
# LTI_AUTH_URL=https://sso.canvaslms.com/api/lti/authorize_redirect

CANVAS_DOMAIN=https://school.instructure.com
CANVAS_API_CLIENT_ID=test-client-id
CANVAS_API_CLIENT_SECRET=test-client-secret
# Alternative: CANVAS_API_CLIENT_SECRET_FILE=/run/secrets/canvas_api_client_secret
CANVAS_REDIRECT_URI=http://localhost:8080/api/oauth2callback

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=canvas_seb
DATABASE_USER=canvas_seb
DATABASE_PASSWORD=canvas_seb
# Alternative: DATABASE_PASSWORD_FILE=/run/secrets/database_password
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000

SESSION_SECRET=local-session-secret
# Alternative: SESSION_SECRET_FILE=/run/secrets/session_secret
STATE_ENCRYPTION_KEY=local-state-encryption-key
# Alternative: STATE_ENCRYPTION_KEY_FILE=/run/secrets/state_encryption_key
# AES-256-GCM keyring for stored Canvas OAuth access/refresh tokens. Values are
# 32-byte base64url keys; generate a unique key before startup and keep retired
# keys while any records still reference them.
OAUTH_TOKEN_ENCRYPTION_MODE=enforce
OAUTH_TOKEN_ENCRYPTION_ACTIVE_KEY_ID=local-v1
OAUTH_TOKEN_ENCRYPTION_KEYRING={"local-v1":"replace-with-a-32-byte-base64url-key"}
# Alternative: OAUTH_TOKEN_ENCRYPTION_KEYRING_FILE=/run/secrets/oauth_token_encryption_keyring
APP_DEBUG_ENABLED=false
# Dev-only detector diagnostics: streams sanitized detector trace details
# (URLs, iframe origins, gate decisions) to Cloud Logging. Rejected on
# production (APP_ENV=prod) deployments.
APP_DETECTOR_DIAGNOSTICS_ENABLED=false
# Cloud Run development testbeds may enable bounded diagnostics only when this
# explicit gate and immutable build-provenance values are also present. The
# locked testbed Cloud Build workflow supplies them; do not set them in prod.
DEV_TESTBED_ENABLED=false
# SOURCE_COMMIT_SHA=
# SOURCE_REF=
# SOURCE_WORKTREE_STATE=clean
# SOURCE_DIFF_SHA=
# CLOUD_BUILD_ID=
# APP_IMAGE_DIGEST=
# Managed fallback. Use 8-128 characters with at least 5 different letters or
# numbers; letters-only and numbers-only values are allowed when not predictable.
# common or predictable values are rejected. Never reuse it as a start password.
SEB_QUIT_PASSWORD=
# Alternative: SEB_QUIT_PASSWORD_FILE=/run/secrets/seb_quit_password
# Concrete school-reviewed resource hostnames only. Identity-provider hosts are rejected.
SEB_REQUIRED_DOMAINS=
# Certificate encryption is enabled by default. Set false only when managed-client
# certificate deployment is not possible; teacher-set start passwords still protect their configs.
SEB_CONFIG_ENCRYPTION_ENABLED=true
SEB_CONFIG_ENCRYPTION_CERT_PATH=.local/seb-certs/seb-config-encryption-local.crt.pem
