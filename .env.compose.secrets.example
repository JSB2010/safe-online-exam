# Copy to .env.secrets, chmod 600, and create every file named below in SECRETS_DIRECTORY.
APP_IMAGE=ghcr.io/jsb2010/safe-online-exam:1.0.0
APP_ENV_FILE=.env.secrets
BIND_ADDRESS=127.0.0.1
APP_PORT=8080
SECRETS_DIRECTORY=./secrets

NODE_ENV=production
APP_ENV=prod
HOST=0.0.0.0
PORT=8080
TOOL_URL=https://seb-tool.example.edu
CANVAS_DOMAIN=https://school.instructure.com
CANVAS_REDIRECT_URI=https://seb-tool.example.edu/api/oauth2callback

LTI_CLIENT_ID=replace-with-canvas-lti-client-id
LTI_DEPLOYMENT_ID=replace-with-canvas-lti-deployment-id
CANVAS_API_CLIENT_ID=replace-with-canvas-developer-key-id

DATABASE_NAME=canvas_seb
DATABASE_USER=canvas_seb
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000

SEB_REQUIRED_DOMAINS=
SEB_CONFIG_ENCRYPTION_ENABLED=true
APP_DEBUG_ENABLED=false
APP_DETECTOR_DIAGNOSTICS_ENABLED=false

# Required files under ./secrets:
# database_password
# lti_private_key
# canvas_api_client_secret
# session_secret
# state_encryption_key
# seb_quit_password (may be empty only when no managed fallback is configured)
# seb-config-encryption.crt.pem (public certificate)
