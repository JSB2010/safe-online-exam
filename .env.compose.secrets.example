# Copy to .env.secrets, chmod 600, and create every file named below in SECRETS_DIRECTORY.
# GitHub Release bundles replace this with their exact immutable GHCR digest.
APP_IMAGE=ghcr.io/jsb2010/safe-online-exam@sha256:REPLACE_WITH_RELEASE_DIGEST
APP_ENV_FILE=.env.secrets
BIND_ADDRESS=127.0.0.1
APP_PORT=8080
SECRETS_DIRECTORY=./secrets
# Required only with: docker compose --profile caddy ... up -d
PUBLIC_HOST=seb-tool.example.edu

NODE_ENV=production
APP_ENV=prod
HOST=0.0.0.0
PORT=8080
TOOL_URL=https://seb-tool.example.edu
CANVAS_DOMAIN=https://school.instructure.com
CANVAS_REDIRECT_URI=https://seb-tool.example.edu/api/oauth2callback

# Canvas Cloud defaults. Override all three for a self-hosted Canvas issuer.
LTI_ISSUER=https://canvas.instructure.com
LTI_KEY_SET_URL=https://sso.canvaslms.com/api/lti/security/jwks
LTI_AUTH_URL=https://sso.canvaslms.com/api/lti/authorize_redirect

LTI_CLIENT_ID=replace-with-canvas-lti-client-id
LTI_DEPLOYMENT_ID=replace-with-canvas-lti-deployment-id
CANVAS_API_CLIENT_ID=replace-with-canvas-developer-key-id

DATABASE_NAME=safe_online_exam
DATABASE_USER=safe_online_exam
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000

OAUTH_TOKEN_ENCRYPTION_MODE=enforce
OAUTH_TOKEN_ENCRYPTION_ACTIVE_KEY_ID=primary

SEB_REQUIRED_DOMAINS=
# Certificate encryption is enabled by default. Set false only when managed-client
# certificate deployment is not possible; teacher-set start passwords still protect their configs.
SEB_CONFIG_ENCRYPTION_ENABLED=true
APP_DEBUG_ENABLED=false
APP_DETECTOR_DIAGNOSTICS_ENABLED=false
# Set to the released version so browser assets change cache keys after upgrades.
APP_ASSET_VERSION=REPLACE_WITH_RELEASE_VERSION

# Required files under ./secrets:
# database_password
# lti_private_key
# canvas_api_client_secret
# session_secret
# state_encryption_key
# oauth_token_encryption_keyring
# seb_quit_password (may be empty only when no managed fallback is configured)
# seb-config-encryption.crt.pem (public certificate)
